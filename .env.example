# Only local development values. Never commit .env.
JARVIS_CODEX_HOME=/absolute/path/to/JarvisCodex
JARVIS_CODEX_DATA_DIR=/absolute/path/to/data/live
TELEGRAM_ALLOWED_USERS=
TELEGRAM_BOT_TOKEN=

# "echo" (default, free, local, no network) or "claude" (real Anthropic
# API calls, real cost). See backends/factory.py.
JARVIS_CODEX_BACKEND=echo
ANTHROPIC_API_KEY=
# Optional, defaults to backends/claude.py's DEFAULT_MODEL if unset.
ANTHROPIC_MODEL=

# Public age recipient for encrypted backups (not a secret). Generate the
# matching identity with `age-keygen` and see docs/05-recovery.md -- the
# private identity itself belongs in a password manager, never here.
JARVIS_CODEX_BACKUP_RECIPIENT=
