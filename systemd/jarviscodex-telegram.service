[Unit]
Description=JarvisCodex Telegram adapter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust this path if your clone of JarvisCodex lives somewhere else.
WorkingDirectory=%h/Work/JarvisCodex
EnvironmentFile=%h/Work/JarvisCodex/.env
ExecStart=/usr/bin/python3 %h/Work/JarvisCodex/apps/telegram/bot.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
